# ========================================================
# PLAYERS PARADISE HUB (playersparadisehub.com) CONFIGURATION
# ========================================================

# 1. MongoDB Database Connection
# For local VPS: mongodb://localhost:27017/players_paradise
# For Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/players_paradise?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/players_paradise

# 2. Security & Session Secrets
JWT_SECRET=players_paradise_cyber_secret_key_2026_panda_gaming_hub

# 3. Domain URL
NEXT_PUBLIC_APP_URL=http://localhost:3001

# 4. Geo-Lock Configuration (Set to true to allow all in dev)
BYPASS_GEO_LOCK=true

# 5. SMTP Email Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@playersparadisehub.com
SMTP_PASS=your_email_password_here
SMTP_FROM=support@playersparadisehub.com

# 6. Mobile App (Capacitor) Remote Server Target
CAPACITOR_SERVER_URL=https://playersparadisehub.com
